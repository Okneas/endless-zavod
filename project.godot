; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="endless-zavod"
run/main_scene="res://hub/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Config="*res://autoload/config.gd"
GameClock="*res://autoload/game_clock.gd"
Progress="*res://autoload/progress.gd"
Inventory="*res://autoload/inventory.gd"
Run="*res://autoload/run.gd"
Shop="*res://autoload/shop.gd"
UserSettings="*res://autoload/user_settings.gd"
DebugTools="*res://autoload/debug_tools.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

