class_name ZoneSettings
extends Resource
## Настройки генерации зоны (срез 6, №41, №80). Данные: data/content/balance/zone_settings.tres.
## Значения по умолчанию нейтральные, числа лежат только в .tres и требуют проверки в игре.

@export_group("Отдел и уровень зоны")
## Зон в отделе (на последнем стоит босс). Параметр, на ранних тестах можно сократить.
@export_range(1, 99, 1) var zones_in_department: int = 1
## Уровень мира в начале игры: потолок уровня зоны (03-run-structure, формула уровня зоны).
@export_range(1, 999, 1) var world_level_start: int = 1
## База отдела: 10 x (номер отдела минус один). В прототипе один отдел, база 0.
## Степень кривой уровня зоны: уровень = 1 + (уровень мира - 1) x ((зона - 1) / (зон - 1)) ^ степень. 1.0 даёт ровный рост,
## больше 1 даёт мягкие первые зоны и крутой конец, меньше 1 наоборот.
@export_range(0.5, 4.0, 0.05) var level_curve_exponent: float = 1.0
## Комната эвакуации стоит в каждой зоне, номер которой кратен этому числу (3 даёт зоны 3, 6 и 9), кроме зоны с боссом (№86).
@export_range(1, 99, 1) var evacuation_every: int = 1

@export_group("Число комнат")
## Комнат без переходов в первой зоне (считая стартовую).
@export_range(2, 60, 1) var rooms_base: int = 2
## Сколько комнат добавляется на каждую следующую зону.
@export_range(0.0, 10.0, 0.05) var rooms_per_zone: float = 0.0
@export_range(2, 80, 1) var rooms_max: int = 2
## Кладовых: в первой зоне и прибавка за зону (округляется вниз).
@export_range(0, 10, 1) var loot_rooms_base: int = 0
@export_range(0.0, 2.0, 0.05) var loot_rooms_per_zone: float = 0.0
## Шанс комнаты-магазина в зоне.
@export_range(0.0, 1.0, 0.05) var shop_chance: float = 0.0

@export_group("Рост зоны")
## Шанс продолжить от одной из самых новых свободных комнат (длинные ветки), иначе от случайной (разветвления).
@export_range(0.0, 1.0, 0.05) var deep_bias: float = 0.0
## Сколько раз пробовать разместить одну комнату, прежде чем отказаться.
@export_range(1, 200, 1) var attempts_per_room: int = 1
## Допуск пересечения габаритов при проверке (комнаты стыкуются плоскостями входов).
@export_range(0.0, 2.0, 0.05, "suffix:м") var overlap_margin: float = 0.0
## Фиксированный сид для отладки (0: каждый раз новый).
@export var debug_seed: int = 0

@export_group("Вертикальные стыки")
## Шанс, что комнате с боем выбирают для подключения свободный проём в потолке или в полу (если такой есть). Остальное
## время вход выбирается как раньше.
@export_range(0.0, 1.0, 0.05) var vertical_chance: float = 0.0
## Лестница внутри проёма стыка двух комнат, стоящих одна над другой (сцена с корнем Node3D; ставится по маркеру входа
## в потолке нижней комнаты, ось X сцены идёт по оси X маркера).
@export var vertical_link: PackedScene

@export_group("Бой и награда")
## Врагов в комнате с боем: в первой зоне, прибавка за зону и предел.
@export_range(1, 40, 1) var enemies_base: int = 1
@export_range(0.0, 5.0, 0.05) var enemies_per_zone: float = 0.0
@export_range(1, 60, 1) var enemies_max: int = 1
## Враги знают, где игрок, с начала боя (в больших комнатах иначе дальние стоят, пока игрок не подойдёт в радиус).
@export var combat_alert_all: bool = false
## Пул врагов для комнат с боем.
@export var enemy_pool: Array[EnemyPoolEntry] = []
## Оружий в кладовой (уровень равен уровню зоны) и деньги за каждую остальную точку награды.
@export_range(0, 10, 1) var loot_weapons: int = 0
## С каким шансом «оружейная» точка награды действительно роняет оружие (иначе там деньги): дефицит оружия (№85).
@export_range(0.0, 1.0, 0.01) var loot_weapon_chance: float = 0.0
## Сколько следующих за оружием точек награды в кладовой отдано под детали оружия (остальные дают деньги).
@export_range(0, 10, 1) var loot_parts: int = 0
@export_range(0, 1000, 1) var loot_money_min: int = 0
@export_range(0, 1000, 1) var loot_money_max: int = 0

@export_group("Навигация врагов")
## Параметры запекаемой сетки навигации (по геометрии всех комнат зоны).
@export_range(0.05, 1.0, 0.05, "suffix:м") var nav_cell_size: float = 0.3
## Высота ячейки по вертикали: чем меньше, тем точнее сетка стыкуется на краях пандусов и под потолком (при высоте
## ячейки 0.3 м округление иногда рвало связность на стыке пандуса и плиты). Максимальный подъём агента кратен ей.
@export_range(0.05, 1.0, 0.05, "suffix:м") var nav_cell_height: float = 0.3
@export_range(0.5, 4.0, 0.05, "suffix:м") var nav_agent_height: float = 1.8
@export_range(0.1, 2.0, 0.05, "suffix:м") var nav_agent_radius: float = 0.5
@export_range(0.0, 2.0, 0.05, "suffix:м") var nav_agent_max_climb: float = 0.4
@export_range(0.0, 85.0, 1.0, "suffix:°") var nav_agent_max_slope: float = 40.0

@export_group("Появление врагов и страховки боя")
## Разброс точки появления вокруг маркера (враги не встают в одну точку), м.
@export_range(0.0, 10.0, 0.5, "suffix:м") var spawn_scatter: float = 0.0
## Минимальное расстояние между только что появившимися врагами, м.
@export_range(0.0, 5.0, 0.1, "suffix:м") var spawn_spacing: float = 0.0
## Сколько мест пробовать для одного врага (место должно быть свободным и на земле), потом враг пропускается.
@export_range(1, 200, 1) var spawn_attempts: int = 1
## На сколько выше земли появляются летающие враги.
@export_range(0.0, 8.0, 0.1, "suffix:м") var flyer_spawn_height: float = 0.0
## Как часто проверяется, не провалился ли враг под зону или не застрял ли в стене. Такой враг переносится на свободное место.
@export_range(0.1, 5.0, 0.1, "suffix:с") var watchdog_interval: float = 1.0
## Ниже самой нижней точки зоны на столько метров враг считается провалившимся.
@export_range(1.0, 100.0, 1.0, "suffix:м") var fall_margin: float = 1.0
