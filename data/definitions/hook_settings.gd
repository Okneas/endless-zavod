class_name HookSettings
extends Resource
## Настройки хука. Данные: data/content/balance/hook_settings.tres.
## В Inspector открываются у узла Hook внутри Player (поле Settings) или двойным щелчком по .tres.
## Значения по умолчанию нейтральные: баланс лежит только в .tres, а не в коде.
## Все числа в .tres стартовые, подобраны ассистентом, требуют проверки в игре.

@export_group("Цель")
## Дальность, на которой луч из прицела находит поверхность.
@export_range(0.0, 200.0, 0.5, "suffix:м") var max_range: float = 0.0
## Насколько камера не доходит до поверхности вдоль её нормали (больше радиуса тела).
@export_range(0.0, 3.0, 0.05, "suffix:м") var surface_offset: float = 0.0

@export_group("Притягивание")
## Потолок скорости притягивания. Он же потолок инерции при отпускании.
@export_range(0.0, 100.0, 0.5, "suffix:м/с") var pull_speed: float = 0.0
## Разгон притягивания: насколько быстро скорость игрока подводится к направлению на точку зацепа.
## Меньше — хук берёт игрока медленнее, а скорость, которая была при зацепе (падение, боковой
## полёт), дольше выравнивается в сторону точки.
@export_range(0.0, 300.0, 1.0, "suffix:м/с²") var pull_acceleration: float = 0.0
## За сколько секунд разгон нарастает с нуля до полного (S-кривая), и за столько же секунд
## затухает гравитация. Больше — мягче старт и дольше «продолжается» прежнее падение или полёт.
@export_range(0.0, 2.0, 0.01, "suffix:с") var acceleration_ramp_time: float = 0.0

@export_group("Долёт: подброс и пружина")
## На каком расстоянии от точки зацепа игрок считается долетевшим.
@export_range(0.0, 3.0, 0.05, "suffix:м") var arrival_distance: float = 0.0
## Скорость подброса вверх в момент долёта. 0 — без подброса.
@export_range(0.0, 30.0, 0.5, "suffix:м/с") var arrival_kick_speed: float = 0.0
## Жёсткость пружины, которая после долёта тянет обратно к точке зацепа. Больше — быстрее колебания.
@export_range(0.0, 400.0, 1.0) var spring_stiffness: float = 0.0
## Затухание пружины: 0 качается бесконечно, около 0.4 слегка перелетает и успокаивается, 1 без раскачки.
@export_range(0.0, 2.0, 0.05) var spring_damping_ratio: float = 0.0

@export_group("Прочее")
## Если игрока по дороге держит препятствие, через сколько секунд он считается долетевшим.
@export_range(0.0, 2.0, 0.05, "suffix:с") var blocked_timeout: float = 0.0
## Толщина верёвки (плейсхолдер из параллелепипеда).
@export_range(0.001, 0.2, 0.001, "suffix:м") var rope_thickness: float = 0.0
