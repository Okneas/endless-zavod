class_name CoverSpot
extends RefCounted
## Место за укрытием (№93): где спрятаться от конкретной угрозы и откуда можно выглянуть. Считается заново под положение угрозы
## (CoverObject.get_spot), поэтому с какой стороны укрытие закрывает, зависит от того, где стоит игрок.

var cover: CoverObject
## Номер места за этим укрытием (у укрытия их capacity штук).
var slot: int = 0
## Точка на земле за укрытием, где враг скрыт от угрозы.
var hide_position: Vector3 = Vector3.ZERO
## Точки по бокам укрытия, на той же глубине: оттуда угрозу видно, и можно выстрелить, не выходя на открытое место.
var peek_positions: Array[Vector3] = []
